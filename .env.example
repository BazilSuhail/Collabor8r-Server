NODE_ENV=development
PORT=4000
# Required in production: MONGO_URI, JWT_SECRET and UPLOAD_SIGNING_SECRET (32+ chars each), CLIENT_ORIGIN
MONGO_URI=mongodb://127.0.0.1:27017/pm_suite
JWT_SECRET=replace-me-dev-only-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Comma separated allowlist; wildcards are rejected
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_SIGNING_SECRET=replace-me-upload-secret
UPLOAD_URL_TTL_SEC=900
# Local file storage behind /uploads (signed URLs); max bytes per upload (25 MB)
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=26214400
# Resend API key for invite emails; leave empty to skip sending
RESEND_API_KEY=
# Sender address for outgoing email
EMAIL_FROM=Collabor8r <onboarding@resend.dev>
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_DAILY_CALL_LIMIT=100
WEBHOOK_TIMEOUT_MS=5000
ACTIVITY_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
# Rate limits: login/register per IP per 15 min, all /api per IP per minute
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=600
# Account lockout
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# false, true, a hop count (1) or a subnet name (loopback) when behind a reverse proxy
TRUST_PROXY=false
# Set false on API replicas that should not run automation, webhooks or the SLA ticker
BACKGROUND_JOBS=true
SHUTDOWN_TIMEOUT_MS=10000
